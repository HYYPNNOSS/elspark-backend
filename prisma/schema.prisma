generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}



model GameStats {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  createdAt DateTime @default(now())
}

model GameSession {
  id         String         @id @default(uuid())
  status     GameStatus     @default(WAITING)
  createdAt  DateTime       @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  winnerId   String?
  players    PlayerInGame[]
  botPlayers BotInGame[]

  boardState  Json?
  currentTurn Int?
}

model PlayerInGame {
  id            String      @id @default(uuid())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])
  gameSessionId String
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime    @default(now())

  @@unique([gameSessionId, userId])
}

model BotInGame {
  id            String      @id @default(uuid())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])
  gameSessionId String
  botId         String
  createdAt     DateTime    @default(now())

  @@unique([gameSessionId, botId])
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}


model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model CoinTransaction {
  id                    Int      @id @default(autoincrement())
  userId                Int
  amount                Int      // Number of coins purchased
  priceGBP              Float    // Price paid in GBP
  stripePaymentIntentId String   @unique
  status                String   // 'pending', 'completed', 'failed'
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("coin_transactions")
}


model ChatConnection {
  id        String   @id @default(uuid())
  user1Id   Int
  user2Id   Int
  roomId    String   @unique
  status    ChatStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  endedAt   DateTime?

  user1 User @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@map("chat_connections")
}

enum ChatStatus {
  ACTIVE
  ENDED
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String   @unique
  password       String
  profilePicture String   @default("/uploads/profiles/profile-default.jpg")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bio      String?


  online   Boolean @default(false)
  isonrand Boolean @default(false)
  looking  Boolean @default(false)

  posts        Post[]           @relation("PostAuthors")
  coownedPosts PostCoowner[]
  collections  PostCollection[]

  comments         Comment[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friends                Friendship[]    @relation("UserFriends")
  friendOf               Friendship[]    @relation("FriendOf")

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  chatAsUser1 ChatConnection[] @relation("ChatUser1")
  chatAsUser2 ChatConnection[] @relation("ChatUser2")

  cyberCoins    Int            @default(10)
  gameStats     GameStats[]
  notifications Notification[] 

  playerInGames PlayerInGame[]

  coinTransactions CoinTransaction[]

  resetTokens PasswordResetToken[]
  aiMessages  AIMsg[]
  aiSessions  AISession[]

  isMooshi     Boolean  @default(false)
  isApproved   Boolean  @default(false)
  color        String?  
  mooshiNumber Int?     @unique
  journal   Json?
  mooshiConv Json?


  @@map("users")
}



model Notification {
  id          String   @id @default(cuid())
  type        String   
  message     String
  user        User     @relation(fields: [userId], references: [id])
  userId      Int      
  postId      String?
  route       String?
  commentId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}


model PostCollection {
  id        Int      @id @default(autoincrement())
  title     String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  posts  PostInCollection[]
  Post   Post?              @relation(fields: [postId], references: [id])
  postId Int?

  @@map("post_collections")
}

model PostInCollection {
  id           Int @id @default(autoincrement())
  postId       Int
  collectionId Int

  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  collection PostCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([postId, collectionId])
  @@map("post_in_collections")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([token])
  @@map("password_reset_tokens")
}

model Post {
  id        Int      @id @default(autoincrement())
  text      String?
  title    String? 
  imageUrl  String?
  videoUrl  String?
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation("PostAuthors", fields: [authorId], references: [id], onDelete: Cascade)

  coowners    PostCoowner[]
  collections PostCollection[]

  comments         Comment[]
  PostInCollection PostInCollection[]

  @@map("posts")
}

model PostCoowner {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@id([postId, userId])
  @@map("post_coowners")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@map("comments")
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  createdAt DateTime @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friendships")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  senderId   Int
  receiverId Int

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AIMsg {
  id        Int      @id @default(autoincrement())
  userId    Int
  sender    String //here nariman either 'user' or 'bot'
  message   String   @db.Text
  sessionId String? 
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model AISession {
  id        String   @id @default(uuid())
  userId    Int
  botId     Int
  duration  Int // in minutes
  startTime DateTime @default(now())
  endTime   DateTime
  isActive  Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_sessions")
}
