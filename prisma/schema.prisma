generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id               Int                   @id @default(autoincrement())
  email            String                @unique
  password         String
  cyberCoins       Decimal               @default(5.00) @db.Decimal(10, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  refreshTokens    AccountRefreshToken[]
  coinTransactions CoinTransaction[]     @relation("AccountTransactions")
  resetTokens      PasswordResetToken[]
  profiles         Profile[]

  @@map("accounts")
}

model Profile {
  id                     Int              @id @default(autoincrement())
  accountId              Int
  username               String           @unique
  profilePicture         String           @default("/uploads/profiles/profile-default.jpg")
  bio                    String?          @db.Text
  color                  String?
  isActive               Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  online                 Boolean          @default(false)
  isonrand               Boolean          @default(false)
  looking                Boolean          @default(false)
  isMooshi               Boolean          @default(false)
  isApproved             Boolean          @default(false)
  mooshiNumber           Int?             @unique
  journal                Json?
  mooshiConv             Json?
  gameStats              GameStats[]
  notifications          Notification[]
  playerInGames          PlayerInGame[]
  aiMessages             AIMsg[]
  aiSessions             AISession[]
  chatAsUser1            ChatConnection[] @relation("ChatUser1")
  chatAsUser2            ChatConnection[] @relation("ChatUser2")
  comments               Comment[]
  following              Follow[]         @relation("UserFollowing")
  followers              Follow[]         @relation("UserFollowers")
  receivedFriendRequests FriendRequest[]  @relation("ReceivedFriendRequests")
  sentFriendRequests     FriendRequest[]  @relation("SentFriendRequests")
  friendOf               Friendship[]     @relation("FriendOf")
  friends                Friendship[]     @relation("UserFriends")
  receivedMessages       Message[]        @relation("ReceivedMessages")
  sentMessages           Message[]        @relation("SentMessages")
  collections            PostCollection[]
  coownedPosts           PostCoowner[]
  posts                  Post[]           @relation("PostAuthors")
  account                Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  uploadedVideos  ElsparkVideo[]    @relation("VideoUploader")
  ownedVideos     VideoOwnership[]  @relation("VideoOwner")
  queuedVideos    LiveTVQueue[]     @relation("QueueUploader")

  @@index([accountId], map: "profiles_accountId_fkey")
  @@map("profiles")
}

model ElsparkVideo {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  url         String
  filename    String
  duration    Float            @default(0)
  fileSize    Int
  uploaderId  Int
  source      String           @default("collection") // 'collection'
  status      String           @default("in_collection") // 'in_collection', 'queued', 'playing', 'played'
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  uploader    Profile          @relation("VideoUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  owners      VideoOwnership[]
  queueItems  LiveTVQueue[]

  @@index([uploaderId], map: "elspark_videos_uploaderId_fkey")
  @@map("elspark_videos")
}

model VideoOwnership {
  profileId        Int
  videoId          String
  ownershipShare   Float           @default(100.0) 
  acquisitionType  String          
  acquisitionPrice Int             
  acquiredAt       DateTime        @default(now())
  profile          Profile         @relation("VideoOwner", fields: [profileId], references: [id], onDelete: Cascade)
  video            ElsparkVideo    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([profileId, videoId])
  @@index([videoId], map: "video_ownership_videoId_fkey")
  @@map("video_ownership")
}

model LiveTVQueue {
  id         String       @id @default(uuid())
  videoId    String
  position   Int
  status     String       @default("waiting") // 'waiting', 'playing', 'played'
  uploaderId Int
  startTime  DateTime?
  endTime    DateTime?
  createdAt  DateTime     @default(now())
  video      ElsparkVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  uploader   Profile      @relation("QueueUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([videoId], map: "live_tv_queue_videoId_fkey")
  @@index([uploaderId], map: "live_tv_queue_uploaderId_fkey")
  @@map("live_tv_queue")
}

model AccountRefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  accountId Int
  profileId Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([accountId], map: "account_refresh_tokens_accountId_fkey")
  @@map("account_refresh_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  accountId Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([accountId], map: "password_reset_tokens_accountId_fkey")
  @@map("password_reset_tokens")
}

model GameStats {
  id        String   @id @default(uuid())
  profileId Int
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "GameStats_profileId_fkey")
}

model GameSession {
  id          Int            @id @default(autoincrement())
  status      GameStatus     @default(WAITING)
  createdAt   DateTime       @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  winnerId    Int?
  boardState  Json?
  currentTurn Int?
  botPlayers  BotInGame[]
  players     PlayerInGame[]
}

model PlayerInGame {
  id            Int         @id @default(autoincrement())
  gameSessionId Int
  profileId     Int
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, profileId])
  @@index([profileId], map: "PlayerInGame_profileId_fkey")
}

model BotInGame {
  id            Int         @id @default(autoincrement())
  gameSessionId Int
  botId         String
  createdAt     DateTime    @default(now())
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id])

  @@unique([gameSessionId, botId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    Profile  @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId], map: "follows_followingId_fkey")
  @@map("follows")
}

model ChatConnection {
  id        String     @id @default(uuid())
  user1Id   Int
  user2Id   Int
  roomId    String     @unique
  status    ChatStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  endedAt   DateTime?
  user1     Profile    @relation("ChatUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     Profile    @relation("ChatUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user2Id], map: "chat_connections_user2Id_fkey")
  @@map("chat_connections")
}

model FriendRequest {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  receiver   Profile  @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     Profile  @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId], map: "friend_requests_receiverId_fkey")
  @@map("friend_requests")
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userId    Int
  friendId  Int
  createdAt DateTime @default(now())
  friend    Profile  @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  user      Profile  @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId], map: "friendships_friendId_fkey")
  @@map("friendships")
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now())
  senderId   Int
  receiverId Int
  receiver   Profile  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     Profile  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId], map: "messages_receiverId_fkey")
  @@index([senderId], map: "messages_senderId_fkey")
  @@map("messages")
}

model Post {
  id               Int                @id @default(autoincrement())
  text             String?            @db.Text
  title            String?
  imageUrl         String?
  videoUrl         String?
  isPrivate        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isAnonymous      Boolean            @default(false)
  originalAuthorId Int?
  deletedAt        DateTime?
  authorId         Int
  comments         Comment[]
  collections      PostCollection[]
  coowners         PostCoowner[]
  PostInCollection PostInCollection[]
  author           Profile            @relation("PostAuthors", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "posts_authorId_fkey")
  @@map("posts")
}

model PostCoowner {
  postId Int
  userId Int
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId], map: "post_coowners_userId_fkey")
  @@map("post_coowners")
}

model PostCollection {
  id        Int                @id @default(autoincrement())
  title     String
  userId    Int
  createdAt DateTime           @default(now())
  postId    Int?
  Post      Post?              @relation(fields: [postId], references: [id])
  user      Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     PostInCollection[]

  @@index([postId], map: "post_collections_postId_fkey")
  @@index([userId], map: "post_collections_userId_fkey")
  @@map("post_collections")
}

model PostInCollection {
  id           Int            @id @default(autoincrement())
  postId       Int
  collectionId Int
  collection   PostCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, collectionId])
  @@index([collectionId], map: "post_in_collections_collectionId_fkey")
  @@map("post_in_collections")
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  authorId  Int
  postId    Int?
  parentId  Int?
  author    Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId], map: "comments_authorId_fkey")
  @@index([parentId], map: "comments_parentId_fkey")
  @@index([postId], map: "comments_postId_fkey")
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  profileId Int
  postId    String?
  route     String?
  commentId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "Notification_profileId_fkey")
}

model CoinTransaction {
  id                    Int      @id @default(autoincrement())
  accountId             Int
  amount                Int
  priceGBP              Float
  stripePaymentIntentId String   @unique
  status                String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  account               Account  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId], map: "coin_transactions_accountId_fkey")
  @@map("coin_transactions")
}

model AIMsg {
  id        Int      @id @default(autoincrement())
  profileId Int
  sender    String
  message   String   @db.Text
  sessionId String?
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "ai_messages_profileId_fkey")
  @@map("ai_messages")
}

model AISession {
  id        String   @id @default(uuid())
  profileId Int
  botId     Int
  duration  Int
  startTime DateTime @default(now())
  endTime   DateTime
  isActive  Boolean  @default(true)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "ai_sessions_profileId_fkey")
  @@map("ai_sessions")
}

enum GameStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ChatStatus {
  ACTIVE
  ENDED
}